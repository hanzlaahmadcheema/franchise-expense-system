# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL / Supabase)
# Required. Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Supabase:
# - Transaction Pooler (recommended for serverless/app): port 6543
# - Session Pooler / Direct: port 5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Optional Pool Configuration
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Optional SSL Override ('true' | 'false' | 'require' | 'disable')
# Defaults to true when connecting to remote/Supabase hosts in production.
DATABASE_SSL=false

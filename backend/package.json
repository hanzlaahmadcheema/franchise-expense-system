{
  "name": "franchise-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate:latest": "tsx src/db/migrator.ts latest",
    "migrate:rollback": "tsx src/db/migrator.ts rollback",
    "auth:provision": "tsx src/scripts/provision-local-accounts.ts",
    "import:august": "NODE_ENV=production tsx src/scripts/import-august-expenses.ts",
    "import:august-jazzload": "NODE_ENV=production tsx src/scripts/import-august-jazzload.ts",
    "test": "tsx src/auth/auth.test.ts && tsx src/auth/localAuth.test.ts && tsx src/catalogs/catalogs.test.ts && tsx src/transactions/transactions.test.ts && tsx src/calculations/calculations.test.ts && tsx src/periods/periods.test.ts && tsx src/calculations/finalClosing.test.ts && tsx src/calculations/commissionSettlement.test.ts && tsx src/calculations/stagedPeriodSettlement.test.ts && tsx src/calculations/finalSettlementLayer.test.ts && tsx src/calculations/day32TransactionSemantics.test.ts && tsx src/calculations/augustFinalVerification.test.ts && tsx src/periods/closedMonthRecoveryAndNegativeStock.test.ts",
    "test:auth": "tsx src/auth/auth.test.ts",
    "test:local-auth": "tsx src/auth/localAuth.test.ts",
    "test:catalogs": "tsx src/catalogs/catalogs.test.ts",
    "test:transactions": "tsx src/transactions/transactions.test.ts",
    "test:calculations": "tsx src/calculations/calculations.test.ts",
    "test:periods": "tsx src/periods/periods.test.ts",
    "test:final-closing": "tsx src/calculations/finalClosing.test.ts",
    "test:commission-settlement": "tsx src/calculations/commissionSettlement.test.ts",
    "test:staged-settlement": "tsx src/calculations/stagedPeriodSettlement.test.ts",
    "test:final-settlement-layer": "tsx src/calculations/finalSettlementLayer.test.ts",
    "test:day32-semantics": "tsx src/calculations/day32TransactionSemantics.test.ts",
    "test:august-verif": "tsx src/calculations/augustFinalVerification.test.ts",
    "test:recovery": "tsx src/periods/closedMonthRecoveryAndNegativeStock.test.ts",
    "test:import-jazzload": "NODE_ENV=production tsx src/scripts/import-august-jazzload.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0",
    "kysely": "^0.27.6",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.6",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3"
  }
}

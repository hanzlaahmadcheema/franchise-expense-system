{
  "name": "franchise-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate:latest": "tsx src/db/migrator.ts latest",
    "migrate:rollback": "tsx src/db/migrator.ts rollback",
    "test": "tsx src/auth/auth.test.ts && tsx src/catalogs/catalogs.test.ts && tsx src/transactions/transactions.test.ts",
    "test:auth": "tsx src/auth/auth.test.ts",
    "test:catalogs": "tsx src/catalogs/catalogs.test.ts",
    "test:transactions": "tsx src/transactions/transactions.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0",
    "kysely": "^0.27.6",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.6",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3"
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function authorizedEmailDoc() {
      return get(/databases/$(database)/documents/authorizedEmails/$(request.auth.token.email));
    }

    function isAuthorizedEmail() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/authorizedEmails/$(request.auth.token.email)) &&
        authorizedEmailDoc().data.active == true;
    }

    function isSelfBootstrappingUser(uid) {
      return isAuthenticated() &&
        request.auth.uid == uid &&
        isAuthorizedEmail() &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.active == true &&
        request.resource.data.role == authorizedEmailDoc().data.role;
    }

    function isOwner() {
      return isAuthenticated() && userDoc().data.role == "owner" && userDoc().data.active == true;
    }

    function isAdmin() {
      return isAuthenticated() &&
        userDoc().data.role in ["admin", "staff"] &&
        userDoc().data.active == true;
    }

    function isActiveUser() {
      return isAuthenticated() && userDoc().data.active == true;
    }

    function canOwnerEditDaily(monthId) {
      return isOwner() &&
        get(/databases/$(database)/documents/months/$(monthId)).data.status == "open";
    }

    function canAdminImportExpense(monthId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/months/$(monthId)).data.status == "open" &&
        request.resource.data.importType == "expense";
    }

    function canAdminWriteExpenseRows(monthId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/months/$(monthId)).data.status == "open";
    }

    function canAdminManageOpenMonth(monthId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/months/$(monthId)).data.status == "open";
    }

    function isLiveDayData(data) {
      return data.dayNo != 32 &&
        data.entryYear == request.time.year() &&
        data.entryMonth == request.time.month() &&
        data.entryDay == request.time.day();
    }

    function isReopenedDayData(data) {
      return "reopenedUntilAt" in data &&
        data.reopenedUntilAt != null &&
        data.reopenedUntilAt > request.time.toMillis();
    }

    function isEditableDayData(data) {
      return (isLiveDayData(data) &&
        (!("lockedAt" in data) || data.lockedAt == null)) ||
        (!isLiveDayData(data) && isReopenedDayData(data));
    }

    function canManageDayData(monthId, data) {
      return get(/databases/$(database)/documents/months/$(monthId)).data.status == "open" &&
        (isOwner() || isAdmin()) &&
        isEditableDayData(data);
    }

    function canReopenPreviousDay(dayId) {
      return (isOwner() || isAdmin()) &&
        dayId != "32" &&
        request.resource.data.dayNo == resource.data.dayNo &&
        request.resource.data.reopenedUntilAt > request.time.toMillis() &&
        request.resource.data.reopenedUntilAt <= (request.time + duration.value(15, "m")).toMillis();
    }

    function canReopenLiveDay(dayId) {
      return (isOwner() || isAdmin()) &&
        dayId != "32" &&
        isLiveDayData(resource.data) &&
        resource.data.lockedAt != null &&
        request.resource.data.dayNo == resource.data.dayNo &&
        request.resource.data.entryYear == resource.data.entryYear &&
        request.resource.data.entryMonth == resource.data.entryMonth &&
        request.resource.data.entryDay == resource.data.entryDay &&
        (!("lockedAt" in request.resource.data) || request.resource.data.lockedAt == null) &&
        (!("reopenedUntilAt" in request.resource.data) || request.resource.data.reopenedUntilAt == null);
    }

    function canCloseEditableDay(monthId, dayId) {
      return get(/databases/$(database)/documents/months/$(monthId)).data.status == "open" &&
        (isOwner() || isAdmin()) &&
        dayId != "32" &&
        isEditableDayData(resource.data) &&
        request.resource.data.dayNo == resource.data.dayNo &&
        request.resource.data.entryYear == resource.data.entryYear &&
        request.resource.data.entryMonth == resource.data.entryMonth &&
        request.resource.data.entryDay == resource.data.entryDay &&
        request.resource.data.lockedAt != null &&
        (!("reopenedUntilAt" in request.resource.data) || request.resource.data.reopenedUntilAt == null);
    }

    function canOwnerCloseAnyDay(monthId, dayId) {
      return get(/databases/$(database)/documents/months/$(monthId)).data.status == "open" &&
        isOwner() &&
        dayId != "32" &&
        request.resource.data.dayNo == resource.data.dayNo &&
        request.resource.data.lockedAt != null &&
        (!("reopenedUntilAt" in request.resource.data) || request.resource.data.reopenedUntilAt == null);
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isOwner());
      allow create: if isSelfBootstrappingUser(uid);
      allow update: if isOwner() || isSelfBootstrappingUser(uid);
      allow delete: if isOwner();
    }

    match /authorizedEmails/{emailId} {
      allow read: if isOwner() || (isAuthenticated() && request.auth.token.email == emailId);
      allow create, update, delete: if isOwner();
    }

    match /months/{monthId} {
      allow read: if isActiveUser();
      allow create: if isOwner() || isAdmin();
      allow update: if isOwner() || (isAdmin() && resource.data.status == "open");
      allow delete: if isOwner();

      match /summary/{summaryId} {
        allow read: if isActiveUser();
        allow create, update: if isOwner() || isAdmin();
        allow delete: if isOwner();
      }

      match /audit/{eventId} {
        allow read: if isOwner();
        allow create: if isOwner() || isAdmin();
        allow update, delete: if isOwner();
      }

      match /days/{dayId} {
        allow read: if isActiveUser();
        allow create: if canOwnerEditDaily(monthId) || canAdminManageOpenMonth(monthId);
        allow update: if canManageDayData(monthId, request.resource.data) ||
          canCloseEditableDay(monthId, dayId) ||
          canOwnerCloseAnyDay(monthId, dayId) ||
          canAdminImportExpense(monthId) ||
          (resource != null && canReopenLiveDay(dayId)) ||
          (resource != null && canReopenPreviousDay(dayId));
        allow delete: if isOwner() || canAdminManageOpenMonth(monthId);
      }

      match /days/{dayId}/expenses/{expenseId} {
        allow read: if isActiveUser();
        allow create, update: if canManageDayData(monthId, get(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)).data);
        allow delete: if isOwner() || canAdminManageOpenMonth(monthId);
      }

      match /days/{dayId}/{subCollection=**}/{docId} {
        allow read: if isActiveUser();
        allow create, update: if canManageDayData(monthId, get(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)).data);
        allow delete: if isOwner() || canAdminManageOpenMonth(monthId);
      }
    }

    match /settings/{catalog}/items/{itemId} {
      allow read: if isActiveUser();
      allow create, update: if isOwner() || isAdmin();
      allow delete: if isOwner() || isAdmin();
    }

    match /settings/notifications/config/{configId} {
      allow read: if isOwner();
      allow create, update, delete: if isOwner();
    }

    match /jazzLoadSettings/rates/items/{rateId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isOwner();
    }

    match /jazzLoadSettings/commissionRules/items/{ruleId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isOwner();
    }

    match /jazzLoadSettings/doProfiles/items/{profileId} {
      allow read: if isActiveUser();
      allow create, update: if isOwner() || isAdmin();
      allow delete: if isOwner();
    }

    match /jazzLoadSettings/doNames/items/{nameId} {
      allow read: if isActiveUser();
      allow create, update: if isOwner() || isAdmin();
      allow delete: if isOwner();
    }

    match /jazzLoadSettings/doLines/items/{lineId} {
      allow read: if isActiveUser();
      allow create, update: if isOwner() || isAdmin();
      allow delete: if isOwner();
    }

    match /jazzLoadSettings/audit/items/{eventId} {
      allow read: if isOwner();
      allow create: if isOwner() || isAdmin();
      allow update, delete: if isOwner();
    }

    match /jazzLoadMonths/{monthId} {
      allow read: if isActiveUser();
      allow create: if isOwner() || isAdmin();
      allow update: if isOwner() || (isAdmin() && resource.data.status == "open" && request.resource.data.status == "open");
      allow delete: if isOwner();

      match /summary/{summaryId} {
        allow read: if isActiveUser();
        allow create, update: if isOwner() || isAdmin();
        allow delete: if isOwner();
      }

      match /audit/{eventId} {
        allow read: if isOwner();
        allow create: if isOwner() || isAdmin();
        allow update, delete: if isOwner();
      }

      match /days/{dayId} {
        allow read: if isActiveUser();
        allow create: if (isOwner() || isAdmin()) &&
          get(/databases/$(database)/documents/jazzLoadMonths/$(monthId)).data.status == "open";
        allow update: if (isOwner() || isAdmin()) &&
          get(/databases/$(database)/documents/jazzLoadMonths/$(monthId)).data.status == "open";
        allow delete: if isOwner();

        match /doEntries/{entryId} {
          allow read: if isActiveUser();
          allow create, update: if (isOwner() || isAdmin()) &&
            get(/databases/$(database)/documents/jazzLoadMonths/$(monthId)).data.status == "open";
          allow delete: if isOwner();
        }

        match /doAssignments/{assignmentId} {
          allow read: if isActiveUser();
          allow create, update: if (isOwner() || isAdmin()) &&
            get(/databases/$(database)/documents/jazzLoadMonths/$(monthId)).data.status == "open";
          allow delete: if isOwner();
        }
      }
    }

    match /stockSettings/products/items/{productId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isOwner();
    }

    match /stockSettings/accounts/items/{accountId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isOwner();
    }

    match /stockSettings/audit/items/{eventId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if isOwner();
    }

    match /stockSettings/opening/items/main {
      allow read: if isActiveUser();
      allow create, update, delete: if isOwner();
    }

    match /stockMonths/{monthId} {
      allow read: if isActiveUser();
      allow create: if isOwner() || isAdmin();
      allow update: if isOwner() || (isAdmin() && resource.data.status == "open" && request.resource.data.status == "open");
      allow delete: if isOwner();

      match /summary/{summaryId} {
        allow read: if isActiveUser();
        allow create, update: if isOwner() || isAdmin();
        allow delete: if isOwner();
      }

      match /audit/{eventId} {
        allow read: if isOwner();
        allow create: if isOwner() || isAdmin();
        allow update, delete: if isOwner();
      }

      match /days/{dayId} {
        allow read: if isActiveUser();
        allow create: if (isOwner() || isAdmin()) &&
          get(/databases/$(database)/documents/stockMonths/$(monthId)).data.status == "open";
        allow update: if (isOwner() || (isAdmin() && (
            resource.data.status == "open" ||
            ("reopenedUntilAt" in resource.data && resource.data.reopenedUntilAt != null && resource.data.reopenedUntilAt > request.time.toMillis())
          ))) &&
          get(/databases/$(database)/documents/stockMonths/$(monthId)).data.status == "open";
        allow delete: if isOwner();

        match /entries/{entryId} {
          allow read: if isActiveUser();
          allow create: if (isOwner() || isAdmin()) &&
            get(/databases/$(database)/documents/stockMonths/$(monthId)).data.status == "open";
          allow update: if (isOwner() || (isAdmin() && (
            get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.status == "open" ||
            ("reopenedUntilAt" in get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data &&
             get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.reopenedUntilAt != null &&
             get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.reopenedUntilAt > request.time.toMillis())
          ))) &&
          get(/databases/$(database)/documents/stockMonths/$(monthId)).data.status == "open";
          allow delete: if isOwner();
        }

        match /stockOut/{entryId} {
          allow read: if isActiveUser();
          allow create: if (isOwner() || isAdmin()) &&
            get(/databases/$(database)/documents/stockMonths/$(monthId)).data.status == "open";
          allow update: if (isOwner() || (isAdmin() && (
            get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.status == "open" ||
            ("reopenedUntilAt" in get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data &&
             get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.reopenedUntilAt != null &&
             get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.reopenedUntilAt > request.time.toMillis())
          ))) &&
          get(/databases/$(database)/documents/stockMonths/$(monthId)).data.status == "open";
          allow delete: if isOwner();
        }

        match /stockIn/{stockInId} {
          allow read: if isActiveUser();
          allow create: if (isOwner() || isAdmin()) &&
            get(/databases/$(database)/documents/stockMonths/$(monthId)).data.status == "open";
          allow update: if (isOwner() || (isAdmin() && (
            get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.status == "open" ||
            ("reopenedUntilAt" in get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data &&
             get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.reopenedUntilAt != null &&
             get(/databases/$(database)/documents/stockMonths/$(monthId)/days/$(dayId)).data.reopenedUntilAt > request.time.toMillis())
          ))) &&
          get(/databases/$(database)/documents/stockMonths/$(monthId)).data.status == "open";
          allow delete: if isOwner();
        }
      }
    }

    match /stockBalances/products/items/{productId} {
      allow read: if isActiveUser();
      allow create, update: if isOwner() || isAdmin();
      allow delete: if isOwner();
    }

    match /stockBalances/accounts/items/{accountId} {
      allow read: if isActiveUser();
      allow create, update: if isOwner() || isAdmin();
      allow delete: if isOwner();
    }

    match /stockBalances/jazzCompany/items/main {
      allow read: if isActiveUser();
      allow create, update: if isOwner() || isAdmin();
      allow delete: if isOwner();
    }

    match /auditLogs/{logId} {
      allow read: if isOwner();
      allow create: if isActiveUser() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.id == logId &&
        request.resource.data.keys().hasAll([
          "id",
          "createdAt",
          "module",
          "action",
          "summary",
          "actorUid",
          "actorEmail",
          "actorRole"
        ]);
      allow update, delete: if false;
    }

    match /notificationLogs/{logId} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}

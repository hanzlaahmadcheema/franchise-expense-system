rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSelfBootstrappingUser(uid) {
      return isAuthenticated() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.active == true &&
        request.resource.data.role == "viewer";
    }

    function isOwner() {
      return isAuthenticated() && userDoc().data.role == "owner" && userDoc().data.active == true;
    }

    function isAdmin() {
      return isAuthenticated() &&
        userDoc().data.role in ["admin", "staff"] &&
        userDoc().data.active == true;
    }

    function isActiveUser() {
      return isAuthenticated() && userDoc().data.active == true;
    }

    function canEditDaily(monthId) {
      return (isOwner() || isAdmin()) &&
        get(/databases/$(database)/documents/months/$(monthId)).data.status == "open";
    }

    function canOwnerEditDaily(monthId) {
      return isOwner() &&
        get(/databases/$(database)/documents/months/$(monthId)).data.status == "open";
    }

    function isLiveAdminDayData(data) {
      return data.entryYear == request.time.year() &&
        data.entryMonth == request.time.month() &&
        data.entryDay == request.time.day() &&
        data.dayNo == request.time.day();
    }

    function canAdminEditLiveDay(monthId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/months/$(monthId)).data.status == "open" &&
        isLiveAdminDayData(request.resource.data);
    }

    function isUnlockedDay() {
      return !("lockedAt" in resource.data) || resource.data.lockedAt == null;
    }

    function parentDayIsUnlocked(monthId, dayId) {
      return !exists(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)) ||
        !("lockedAt" in get(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)).data) ||
        get(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)).data.lockedAt == null;
    }

    function parentDayIsLiveAdminDay(monthId, dayId) {
      return exists(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)) &&
        get(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)).data.entryYear == request.time.year() &&
        get(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)).data.entryMonth == request.time.month() &&
        get(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)).data.entryDay == request.time.day() &&
        get(/databases/$(database)/documents/months/$(monthId)/days/$(dayId)).data.dayNo == request.time.day();
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isOwner());
      allow create: if isSelfBootstrappingUser(uid);
      allow update, delete: if isOwner();
    }

    match /months/{monthId} {
      allow read: if isActiveUser();
      allow create: if isOwner() || isAdmin();
      allow update: if isOwner() || (isAdmin() && resource.data.status == "open");
      allow delete: if isOwner();

      match /summary/{summaryId} {
        allow read: if isActiveUser();
        allow create, update: if isOwner() || canEditDaily(monthId);
        allow delete: if isOwner();
      }

      match /audit/{eventId} {
        allow read: if isActiveUser();
        allow create: if isOwner() || isAdmin();
        allow update, delete: if isOwner();
      }

      match /days/{dayId} {
        allow read: if isActiveUser();
        allow create: if canOwnerEditDaily(monthId) || canAdminEditLiveDay(monthId);
        allow update: if canOwnerEditDaily(monthId) ||
          (canAdminEditLiveDay(monthId) && isUnlockedDay()) ||
          (isAdmin() && request.resource.data.diff(resource.data).changedKeys().hasOnly(["updatedAt"]));
        allow delete: if isOwner();
      }

      match /days/{dayId}/{subCollection=**}/{docId} {
        allow read: if isActiveUser();
        allow create, update: if canOwnerEditDaily(monthId) ||
          (isAdmin() &&
            get(/databases/$(database)/documents/months/$(monthId)).data.status == "open" &&
            parentDayIsLiveAdminDay(monthId, dayId) &&
            parentDayIsUnlocked(monthId, dayId)) ||
          (isAdmin() &&
            get(/databases/$(database)/documents/months/$(monthId)).data.status == "open" &&
            request.resource.data == resource.data);
        allow delete: if isOwner();
      }
    }

    match /settings/{catalog}/items/{itemId} {
      allow read: if isActiveUser();
      allow create, update: if isOwner() || isAdmin();
      allow delete: if isOwner();
    }
  }
}

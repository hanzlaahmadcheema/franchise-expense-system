{
  "name": "franchise-expense-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator:rules": "firebase emulators:exec --only firestore \"vitest run src/shared/ledger/firestoreRules.integration.test.ts\"",
    "test:emulator:callables": "npm --prefix functions run build && FUNCTIONS_EMULATOR_ORIGIN=http://127.0.0.1:5001 firebase emulators:exec --only firestore,functions,auth \"vitest run src/shared/ledger/callableRecalculation.integration.test.ts\"",
    "reconcile": "node scripts/reconcile.mjs",
    "ledger:migrate": "node scripts/ledger-v2-migration.mjs",
    "ledger:dry-run:may2026": "node scripts/ledger-v2-migration.mjs --month 2026-05 --dry-run --output-report tmp/ledger-v2-2026-05-report.json --backup-file tmp/ledger-v2-2026-05-backup.json",
    "ledger:inspect:may2026": "node scripts/inspect-ledger-v2-report.mjs --report tmp/ledger-v2-2026-05-report.json --backup tmp/ledger-v2-2026-05-backup.json --output tmp/ledger-v2-2026-05-inspection.json --strict"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "firebase": "^11.7.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.3"
  }
}
